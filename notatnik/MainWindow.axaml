<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:notatnik"
        mc:Ignorable="d"
        x:Class="notatnik.MainWindow"
        Title="Notatnik"
        Width="1100"
        Height="720"
        MinWidth="800"
        MinHeight="560"
        Background="#F5F6FA">
    <Grid ColumnDefinitions="320,*">
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E7E9F0" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,28">
                    <Border Width="42" Height="42" CornerRadius="13" Background="#635BDB">
                        <TextBlock Text="N" Foreground="White" FontSize="23" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Notatnik" FontSize="20" FontWeight="Bold" Foreground="#22243A"/>
                        <TextBlock Text="Twoje myśli, zawsze pod ręką" FontSize="11" Foreground="#888BA0"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                    <TextBlock Text="ZAPISANE NOTATKI" FontSize="11" FontWeight="Bold"
                               Foreground="#85889C" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Background="#F0EFFD" CornerRadius="10" Padding="9,3">
                        <TextBlock x:Name="NoteCountText" Text="0" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#635BDB"/>
                    </Border>
                </Grid>

                <ListBox x:Name="NotesList"
                         Grid.Row="2"
                         SelectionChanged="NotesList_SelectionChanged"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:Note">
                            <Border Padding="13" Margin="0,0,0,8" CornerRadius="12" Background="#F7F7FB">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#292B40" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Preview}" FontSize="12" Foreground="#777A8F"
                                               TextWrapping="Wrap" MaxHeight="34"/>
                                    <TextBlock Text="{Binding UpdatedAtLabel}" FontSize="10" Foreground="#A0A2B2"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="StorageText" Grid.Row="3" Text="Notatki są zapisywane w pliku notatki.md"
                           FontSize="10" Foreground="#A0A2B2" TextWrapping="Wrap" Margin="0,14,0,0"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="40,32">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,24">
                <StackPanel Spacing="4">
                    <TextBlock Text="Twoja przestrzeń" FontSize="12" Foreground="#888BA0"/>
                    <TextBlock x:Name="PageTitleText" Text="Nowa notatka" FontSize="25"
                               FontWeight="Bold" Foreground="#22243A"/>
                </StackPanel>
                <Button Grid.Column="1" Content="+ Nowa notatka" Click="NewNote_Click"
                        Padding="18,11" CornerRadius="10" Background="#FFFFFF"
                        BorderBrush="#E3E4EC" BorderThickness="1" Foreground="#4E5064"
                        VerticalAlignment="Center"/>
            </Grid>

            <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="18" Padding="32"
                    BorderBrush="#ECECF2" BorderThickness="1">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="TYTUŁ" FontSize="11" FontWeight="Bold" Foreground="#85889C"/>
                        <TextBox x:Name="TitleInput" PlaceholderText="Nadaj notatce tytuł..."
                                 FontSize="19" FontWeight="SemiBold" Padding="14,12"
                                 CornerRadius="10" BorderBrush="#E7E8EF" BorderThickness="1"
                                 Background="#FBFBFD"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="8">
                        <TextBlock Text="TREŚĆ" FontSize="11" FontWeight="Bold" Foreground="#85889C"/>
                        <TextBlock Text="Zapisz pomysł, przypomnienie lub wszystko, co chcesz zachować."
                                   FontSize="12" Foreground="#A0A2B2"/>
                    </StackPanel>
                    <TextBox x:Name="ContentInput" Grid.Row="2" PlaceholderText="Zacznij pisać..."
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                             FontSize="14" Padding="16"
                             CornerRadius="10" BorderBrush="#E7E8EF" BorderThickness="1"
                             Background="#FBFBFD"/>
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock x:Name="StatusText" Text="" FontSize="12" Foreground="#777A8F"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button Grid.Column="1" Content="Zapisz notatkę" Click="SaveNote_Click"
                                Padding="22,12" CornerRadius="10" Background="#635BDB"
                                Foreground="White" FontWeight="SemiBold"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
